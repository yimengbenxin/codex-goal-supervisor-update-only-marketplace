      "request_classified",
      "ticket_structured",
      "machine_acceptance_present",
      "acceptance_consumer_known",
      "allowed_paths_present",
      "forbidden_paths_present",
      "budget_present",
      "drift_signals_present",
      "raw_shell_acceptance_forbidden",
      "scope_anchor_present"
