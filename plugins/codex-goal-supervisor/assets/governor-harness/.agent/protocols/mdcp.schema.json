    "layer_2_company_roles": [
      "strategy",
      "business",
      "product",
      "engineering",
      "architecture",
      "qa",
      "scope_cost",
      "custodian",
      "janitor",
      "auditor"
    ],
    "layer_2_company_subagents": [
      "mandatory",
      "complexity_tier",
      "required_subagents",
      "main_thread",
      "runtime_binding",
      "runtime_execution_verified",
      "ceo_confirmation",
