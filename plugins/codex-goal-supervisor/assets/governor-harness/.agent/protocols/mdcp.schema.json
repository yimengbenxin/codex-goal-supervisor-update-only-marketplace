      "north_star_goal",
      "goal_anchor",
      "scope_anchor",
      "conversation_plane",
      "precision_level",
      "time_cost_signal",
      "value_signal",
      "metacognition_lock_signal",
      "loop_risk",
      "consumer_mismatch_risk",
      "acceptance_consumer",
      "scope_sink_risk"
    ],
    "layer_1_pass_criteria": [
